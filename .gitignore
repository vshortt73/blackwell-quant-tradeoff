__pycache__/
*.pyc
# Inputs are excluded by default (licensing / contamination), with an explicit
# exception for the synthetic prompt set: it is generated deterministically by
# harness/make_prompts.py, carries no licensing question, and committing it is
# what lets a reader rerun the EXACT inputs the numbers came from.
data/*
!data/prompts_512in.txt
!data/tasks.example.jsonl

# Full per-item task text for debugging. results/raw/ is committed; this is not,
# so task sets can be built from private material without publishing them.
results/audit/
models/
.venv/
*.log
